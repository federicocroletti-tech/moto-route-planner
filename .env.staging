VITE_APP_ENV=staging
VITE_APP_NAME=MotoRoute Planner
VITE_DEFAULT_LANGUAGE=it
VITE_ENABLE_MOCKS=true
VITE_AUTH_MODE=mock
VITE_KEYCLOAK_URL=https://keycloak.staging.example.com
VITE_KEYCLOAK_REALM=motoroute
VITE_KEYCLOAK_CLIENT_ID=motoroute-frontend
VITE_WMS_BASE_URL=https://wms.staging.example.com/geoserver/wms
VITE_WMS_LAYERS=
VITE_FEATURE_ENABLE_FAVORITES=true
VITE_FEATURE_ENABLE_DASHBOARD=true
VITE_FEATURE_ENABLE_KEYCLOAK=false
VITE_FEATURE_ENABLE_MOCK_AUTH=true
VITE_FEATURE_ENABLE_WMS_LAYERS=true
VITE_FEATURE_ENABLE_CREATE_ITINERARY=true
VITE_FEATURE_ENABLE_DARK_MODE=true
VITE_FEATURE_ENABLE_EXPORT_PDF_MOCK=true
